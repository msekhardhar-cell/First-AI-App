# OmniChat AI - Environment Configuration
# Copy this file to .env and insert your API keys (optional if using Judge Sandbox mode)

# Google Gemini API Key (Get free key at: https://aistudio.google.com/)
GEMINI_API_KEY=

# Groq API Key (Get free ultra-fast key at: https://console.groq.com/)
GROQ_API_KEY=

# Default Model Provider (gemini | groq | sandbox)
DEFAULT_PROVIDER=sandbox
